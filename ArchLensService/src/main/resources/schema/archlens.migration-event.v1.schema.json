{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archlens.local/schema/archlens.migration-event.v1.schema.json",
  "title": "ArchLens MigrationEvent v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "revision", "sequence", "occurredAt", "type", "artifactHash", "errorCode"],
  "properties": {
    "schemaVersion": {"const": "archlens.migration-event.v1"},
    "runId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "occurredAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "type": {"enum": ["CREATED", "TASK_STARTED", "TASK_COMPLETED", "GAP_RECORDED", "PLAN_DRAFTED", "VALIDATION_RECORDED", "NEEDS_INPUT", "CANCELLED", "SEALED", "ERROR"]},
    "artifactHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "errorCode": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,99}$"}
  },
  "if": {"properties": {"type": {"const": "ERROR"}}},
  "then": {"properties": {"errorCode": {"type": "string"}}},
  "else": {"properties": {"errorCode": {"type": "null"}}}
}

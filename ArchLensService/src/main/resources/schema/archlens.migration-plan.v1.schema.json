{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archlens.local/schema/archlens.migration-plan.v1.schema.json",
  "title": "ArchLens MigrationPlan v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "identity", "objectiveAndScope", "currentArchitecture", "alternatives", "selectedAlternativeId", "targetArchitecture", "mappings", "workItems", "validationPlan", "rolloutAndRollback", "assumptionsAndGaps", "evidenceRefs", "decisionRefs", "estimates"],
  "properties": {
    "schemaVersion": {"const": "archlens.migration-plan.v1"},
    "identity": {"$ref": "#/$defs/identity"},
    "objectiveAndScope": {"$ref": "#/$defs/objectiveAndScope"},
    "currentArchitecture": {"$ref": "#/$defs/section"},
    "alternatives": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/alternative"}},
    "selectedAlternativeId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "targetArchitecture": {"$ref": "#/$defs/section"},
    "mappings": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/mapping"}},
    "workItems": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/workItem"}},
    "validationPlan": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/validationItem"}},
    "rolloutAndRollback": {"$ref": "#/$defs/rolloutAndRollback"},
    "assumptionsAndGaps": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/assumption"}},
    "evidenceRefs": {"$ref": "#/$defs/evidenceIds"},
    "decisionRefs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "estimates": {"$ref": "#/$defs/estimate"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,99}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceIds": {"type": "array", "maxItems": 2048, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "text1000": {"type": "string", "minLength": 1, "maxLength": 1000},
    "textList128": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/text1000"}},
    "idList128": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "idList64": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["planId", "caseId", "runId", "revision", "requestHash", "snapshotId", "snapshotHash"],
      "properties": {
        "planId": {"$ref": "#/$defs/id"}, "caseId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/uuid"}, "revision": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "requestHash": {"$ref": "#/$defs/hash"}, "snapshotId": {"$ref": "#/$defs/id"},
        "snapshotHash": {"$ref": "#/$defs/hash"}
      }
    },
    "objectiveAndScope": {
      "type": "object", "additionalProperties": false,
      "required": ["objective", "analysisMode", "acceptanceScope"],
      "properties": {
        "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
        "analysisMode": {"enum": ["CODE_ONLY", "DATABASE_ONLY", "JOINT"]},
        "acceptanceScope": {"$ref": "#/$defs/acceptanceScope"}
      }
    },
    "acceptanceScope": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "requiredSourceRefs", "requiredSubjects", "requiredPaths", "requiredConstraintIds", "requiredInvariantIds", "requiredValidationLevels", "acceptedUnknowns"],
      "properties": {
        "level": {"enum": ["A0", "A1", "A2"]},
        "requiredSourceRefs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "requiredSubjects": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "requiredPaths": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "requiredConstraintIds": {"$ref": "#/$defs/idList64"},
        "requiredInvariantIds": {"$ref": "#/$defs/idList64"},
        "requiredValidationLevels": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["V1", "V2", "V3"]}},
        "acceptedUnknowns": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/acceptedUnknown"}}
      },
      "allOf": [
        {"if": {"properties": {"level": {"enum": ["A1", "A2"]}}}, "then": {"properties": {"requiredValidationLevels": {"contains": {"const": "V1"}}}}},
        {"if": {"properties": {"level": {"const": "A2"}}}, "then": {"properties": {"requiredValidationLevels": {"contains": {"const": "V3"}}}}}
      ]
    },
    "acceptedUnknown": {
      "type": "object", "additionalProperties": false, "required": ["id", "impact", "confirmedBy"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "impact": {"$ref": "#/$defs/text1000"}, "confirmedBy": {"$ref": "#/$defs/id"}}
    },
    "section": {
      "type": "object", "additionalProperties": false, "required": ["summary", "evidenceRefs", "limitations"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidenceRefs": {"type": "array", "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "limitations": {"$ref": "#/$defs/textList128"}
      }
    },
    "alternative": {
      "type": "object", "additionalProperties": false,
      "required": ["alternativeId", "description", "rationale", "evidenceRefs"],
      "properties": {
        "alternativeId": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidenceRefs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["subjectId", "disposition", "rationale", "evidenceRefs"],
      "properties": {
        "subjectId": {"$ref": "#/$defs/id"},
        "disposition": {"enum": ["KEEP", "REPLACE", "REWRITE", "SPLIT", "RETIRE", "UNDECIDED"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidenceRefs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "workItem": {
      "type": "object", "additionalProperties": false,
      "required": ["workItemId", "title", "sourceSubjectRefs", "changeDescription", "evidenceRefs", "assumptionRefs", "dependsOn", "prerequisites", "deliverables", "acceptanceCriteria", "validationRefs", "priorityBasis"],
      "properties": {
        "workItemId": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "sourceSubjectRefs": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "changeDescription": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidenceRefs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "assumptionRefs": {"$ref": "#/$defs/idList128"},
        "dependsOn": {"$ref": "#/$defs/idList128"},
        "prerequisites": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/text1000"}},
        "deliverables": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/text1000"}},
        "acceptanceCriteria": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/text1000"}},
        "validationRefs": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "priorityBasis": {"$ref": "#/$defs/text1000"}
      },
      "anyOf": [{"properties": {"evidenceRefs": {"minItems": 1}}}, {"properties": {"assumptionRefs": {"minItems": 1}}}]
    },
    "validationItem": {
      "type": "object", "additionalProperties": false,
      "required": ["validationId", "level", "invariantRefs", "evidenceRefs", "method", "expectedCriteria", "testSpecHash", "required"],
      "properties": {
        "validationId": {"$ref": "#/$defs/id"}, "level": {"enum": ["V1", "V2", "V3"]},
        "invariantRefs": {"$ref": "#/$defs/idList128"},
        "evidenceRefs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "method": {"type": "string", "minLength": 1, "maxLength": 2000},
        "expectedCriteria": {"type": "string", "minLength": 1, "maxLength": 2000},
        "testSpecHash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "required": {"type": "boolean"}
      }
    },
    "rolloutAndRollback": {
      "type": "object", "additionalProperties": false,
      "required": ["rolloutSteps", "rollbackSteps", "irreversibleLimits"],
      "properties": {"rolloutSteps": {"$ref": "#/$defs/textList128"}, "rollbackSteps": {"$ref": "#/$defs/textList128"}, "irreversibleLimits": {"$ref": "#/$defs/textList128"}}
    },
    "assumption": {
      "type": "object", "additionalProperties": false,
      "required": ["assumptionId", "claim", "verificationNeeded", "blocking"],
      "properties": {
        "assumptionId": {"$ref": "#/$defs/id"},
        "claim": {"type": "string", "minLength": 1, "maxLength": 2000},
        "verificationNeeded": {"type": "string", "minLength": 1, "maxLength": 2000},
        "blocking": {"type": "boolean"}
      }
    },
    "estimate": {
      "type": "object", "additionalProperties": false,
      "required": ["minDays", "maxDays", "basis", "missingReason"],
      "properties": {
        "minDays": {"type": ["integer", "null"], "minimum": 0},
        "maxDays": {"type": ["integer", "null"], "maximum": 3650},
        "basis": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
        "missingReason": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
      },
      "if": {"properties": {"minDays": {"type": "integer"}}},
      "then": {"properties": {"maxDays": {"type": "integer"}, "basis": {"type": "string"}, "missingReason": {"type": "null"}}},
      "else": {"properties": {"maxDays": {"type": "null"}, "basis": {"type": "null"}, "missingReason": {"type": "string"}}}
    }
  }
}

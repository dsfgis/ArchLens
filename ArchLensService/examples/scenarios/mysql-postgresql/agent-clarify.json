  "columnRequest": null,
  "collectionBudget": {"maxFiles": 10, "maxBytes": 100000, "timeoutMillis": 10000},
  "agentBudget": {"maxModelCalls": 10, "maxToolCalls": 12, "timeoutMillis": 120000}
}

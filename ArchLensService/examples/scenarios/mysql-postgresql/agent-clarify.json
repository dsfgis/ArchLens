{
  "schemaVersion": "archlens.agent.v1",
  "objective": "调查 MySQL 到 PostgreSQL 的迁移兼容性。源数据库具体版本待用户补充，请先澄清源版本。",
  "target": {"scenario": "DATABASE_MIGRATION", "sourceProfile": {"product": "MySQL", "version": null}, "targetProfile": {"product": "PostgreSQL", "version": "16"}},
